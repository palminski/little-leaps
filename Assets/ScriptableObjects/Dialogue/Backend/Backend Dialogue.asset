MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7522d7d9b205b734b95fb33790c047dc, type: 3}
  m_Name: Backend Dialogue
  m_EditorClassIdentifier: 
  dialogueSentences:
  - text: 'Welcome fellow RABIT!


      You have found the secret area where you
      can max out your attunement!


      This will result in a much higher point
      multiplier than usual, but a much higher difficulty as well!


      Would
      you like to give it a go?


      Please make selection:

      --------------------------'
    dialogueOptions:
    - option: Max Attunement
      nextDialogue: {fileID: 0}
      optionEvent: {fileID: 0}
      triggerEvent: {fileID: 11400000, guid: 51eba1cc9c628604ea45bafa5a32f961, type: 2}
      sideText: 'Set RABIT attunement to max.

        This will result in a difficult
        climb.'
    - option: Do Not Attune
      nextDialogue: {fileID: 0}
      optionEvent: {fileID: 0}
      triggerEvent: {fileID: 11400000, guid: b6abaed52a2078342bfa6bd9893ba06b, type: 2}
      sideText: "Return to Border entrance without attunement.\r\nThis will not change
        VNT absorption rate\r"
